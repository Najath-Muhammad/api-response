{
  "name": "@najathm/api-response",
  "version": "1.0.0",
  "description": "Reusable utilities for Express.js applications to standardize API responses, error handling, pagination, and async route handling.",
  "keywords": [
    "express",
    "api",
    "response",
    "error-handling",
    "pagination",
    "typescript",
    "middleware",
    "async-handler",
    "api-response",
    "rest"
  ],
  "author": "Najath Muhammad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Najath-Muhammad/api-response.git"
  },
  "bugs": {
    "url": "https://github.com/Najath-Muhammad/api-response/issues"
  },
  "homepage": "https://github.com/Najath-Muhammad/api-response#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "postinstall.js"
  ],
  "scripts": {
    "postinstall": "node postinstall.js",
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "peerDependencies": {
    "express": ">=4.18.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
