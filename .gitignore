# Dependencies — never commit, regenerated by npm install
node_modules/

# Build output — generated by tsup on every npm run build
dist/

# Environment variables — NEVER commit these
.env
.env.local
.env.*.local
.env.production

# Test coverage
coverage/

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# npm pack tarballs (created by npm pack)
*.tgz

# TypeScript incremental build cache
*.tsbuildinfo
